<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', {title: "Conformation"}) %>
  </head>
  <body>
    <h1>Thank you for your order, <%= order.fname %>!</h1>
    <h2>Order Summary</h2>
    <p>Order ID: <%= order.id %> </p>
    <p>Name: <%= order.fname %> <%= order.lname %></p>
    <p>Email: <%= order.email %></p>
    <p>Delivery Method: <%= order.method %></p>
    <p>Toppings: <%= order.toppings %></p>
    <p>Size: <%= order.size %></p>
    <p>Comment: <%= order.comment %></p>
    <p>Date and Time <%= order.timestamp %></p>

    <a href="/" class="button">Order another?</a>
  </body>
</html>
