<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head.ejs', {title: "Admin Page"}) %>

  <!-- Must come first -->
  <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
  <!-- Add data table information -->
  <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
  <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
</head>

<body>
  <h1>Orders</h1>

  <table id="order-table" class="display">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Method</th>
        <th>Toppings</th>
        <th>Size</th>
        <th>Comment</th>
        <th>Date and Time</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(order => { %>
      <tr>
        <td><%= order.id %></td>
        <td><%= order.fname %> <%= order.lname %></td>
        <td><%= order.email %></td>
        <td><%= order.method %></td>
        <td><%= order.toppings %></td>
        <td><%= order.size %></td>
        <td><%= order.comment %></td>
        <td><%= order.timestamp.toLocaleString() %></td>
      </tr>
        <% }); %>
    </tbody>
  </table>
  <a href="/" class="button">Go back</a>

  <script>
    new DataTable('#order-table');
  </script>
</body>

</html>